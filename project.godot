; ENERGY INC. — Godot 4 vertical slice
config_version=5

[application]
config/name="ENERGY INC."
run/main_scene="res://factory/factory.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/version="0.2.0"
config/icon="res://art/icons/app.svg"
config/description="Sleep is temporary. Productivity is forever."

[autoload]
InputBindings="*res://systems/input_bindings.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
anti_aliasing/quality/msaa_3d=2
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.045, 0.065, 0.085, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=18.0

[layer_names]
3d_physics/layer_1="Factory"
3d_physics/layer_2="Workers"
3d_physics/layer_3="Carryable items"
3d_physics/layer_4="Interactable machines"
